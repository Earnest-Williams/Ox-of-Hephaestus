  "design_decisions": {
    "rack_cross_connection": "MIND-03 enclosed in monitored lockable rack inside XCON-GAP-23; crossing remains passable on both trunks, no new pressure cell or whole-room lock",
    "original_ship_untouched": true,
    "medium": "two independent passive optical multi-drop rail loops with local active transceivers contained in the power-metered compute units; no central switch as a single point of failure",
    "rated_rotary_links": "Two new continuously rated A/B data couplers independent of the existing indexed passenger capsules; the passenger passage is not a data cable",
    "gateway_policy": "No remotely operable isolator becomes network-actuated by fitting backbone alone; world permissions, gateway and local takeover must be separately commissioned",
    "thermal_policy": "Five independent local finite thermal buffers; no lead-mind machine counted operational until actual cooling and connection have been established. Central LT loss does not confer unlimited heat absorption."
  },
